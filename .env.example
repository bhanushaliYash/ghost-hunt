# Copy to .env.local. Leave a line blank to skip that source.
# Keys are read only on the server. Do not prefix them with NEXT_PUBLIC_.

ABUSECH_AUTH_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GREYNOISE_API_KEY=
SHODAN_API_KEY=
CENSYS_API_TOKEN=
NVD_API_KEY=
SNYK_TOKEN=
ANYRUN_API_KEY=
GEMINI_API_KEY=

# Neon connection string for pinned cases only. Blank hides the pin control.
DATABASE_URL=

# Local Elasticsearch. Blank leaves the Lab page offline.
ELASTIC_URL=
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=

# Site origin allowed to call /api/lookup from the browser.
APP_ORIGIN=http://localhost:3000
